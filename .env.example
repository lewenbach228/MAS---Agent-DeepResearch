# DeepResearch Agent — Configuration
# Copier ce fichier en .env et remplir les valeurs

# Clé API OpenAI (obligatoire) — utilisée par l'agent pour la recherche web
OPENAI_API_KEY=sk-votre_cle_ici

# Token du bot Discord (obligatoire) — depuis https://discord.com/developers/applications
DISCORD_TOKEN=votre_token_discord

# ID du bot Discord (obligatoire) — depuis https://discord.com/developers/applications
DISCORD_CLIENT_ID=votre_client_id

# URL de base du site (optionnel, défaut: http://localhost:3000)
BASE_URL=http://localhost:3000

# Chemin de la base de données SQLite (optionnel)
DATABASE_PATH=./data/deepresearch.db

# ID du serveur Discord pour les commandes instantanées (optionnel)
# Sans cette variable, les commandes sont globales et mettent ~1h à se propager
GUILD_ID=

# ─── DeepResearch Agent — Variables d'environnement ───

# Token du bot Discord (obligatoire pour lancer le bot)
# Obtenable sur https://discord.com/developers/applications
DISCORD_TOKEN=ton_token_ici

# ID du bot Discord (obligatoire)
# Visible dans la même page developpeur Discord
DISCORD_CLIENT_ID=ton_client_id_ici

# Optionnel : ID du serveur Discord pour les commandes instantanées
# Si absent, les commandes sont globales (~1h de propagation)
GUILD_ID=

# Clé API OpenAI globale (optionnelle avec BYOK)
# Si absente, seuls les utilisateurs avec /setkey peuvent utiliser le bot
# Obtenable sur https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Port du serveur HTTP (optionnel, défaut: 3000)
PORT=3000

# URL de base (optionnel, défaut: http://localhost:PORT)
BASE_URL=http://localhost:3000

# Chemin de la base SQLite (optionnel)
# DATABASE_PATH=./data/deepresearch.db
